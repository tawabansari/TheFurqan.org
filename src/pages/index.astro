---
import Home from "../components/Home.astro";
---

<Home lang="en" />
<script is:inline>
  try {
    const supported = ["en", "fa", "ar"];
    const saved = localStorage.getItem("furqan-language");
    const preferred = supported.includes(saved)
      ? saved
      : navigator.languages
          .map((l) => l.split("-")[0])
          .find((l) => supported.includes(l));
    if (preferred) location.replace("/" + preferred + "/");
  } catch {}
</script>
