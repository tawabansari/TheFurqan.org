---
import { quranText } from "../lib/quran";
/** Labels and references are required so meaning never depends on color alone. */
interface Props {
  kind: "quran" | "hadith" | "source";
  label: string;
  reference: string;
  excerpt?: string;
  language?: string;
  direction?: "rtl" | "ltr";
}
const {
  kind,
  label,
  reference,
  excerpt,
  language = "ar",
  direction = "rtl",
} = Astro.props;
---

<figure class="quote">
  <blockquote class={`quote-${kind}`} lang={language} dir={direction}>
    {kind === "quran" ? quranText(reference, excerpt) : <slot />}
  </blockquote>
  <slot name="translation" />
  <figcaption class="quote-label">
    {label} · {reference}
  </figcaption>
</figure>
