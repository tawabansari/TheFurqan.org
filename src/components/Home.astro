---
import { copy, languages } from "../data/locales";
import surahs from "../data/surahs.json";
import "../styles/global.css";
const {
  lang = "en",
  pageTitle,
  description,
} = Astro.props as {
  lang: keyof typeof copy;
  pageTitle?: string;
  description?: string;
};
const pageSuffix = Astro.url.pathname
  .split("/")
  .filter(Boolean)
  .slice(1)
  .join("/");
const c = copy[lang];
const icon = {
  search: "M21 21l-5-5M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0",
  menu: "M4 6h16M4 12h16M4 18h16",
  arrow: "M5 12h14m-5-5 5 5-5 5",
  globe:
    "M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0M3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18",
  close: "m6 6 12 12M6 18 18 6",
};
---

<!doctype html>
<html lang={lang} dir={lang === "en" ? "ltr" : "rtl"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description || c.trustText} />
    <title>{pageTitle ? `${pageTitle} | The Furqan · الفرقان` : "The Furqan · الفرقان"}</title>
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>
      try {
        const t = localStorage.getItem("furqan-theme");
        document.documentElement.dataset.theme =
          t ||
          (matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        const s = Number(localStorage.getItem("furqan-size") || 100);
        document.documentElement.style.fontSize =
          ([80, 90, 100, 110, 120, 130].includes(s) ? s : 100) + "%";
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      {c.start}
    </a>
    <header class="top">
      <div class="wrap header">
        <button
          class="circle"
          data-open="menu"
          aria-label={c.menu}
          title={c.menu}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={icon.menu} />
          </svg>
        </button>
        <a class="brand" href={`/${lang}/`} aria-label="The Furqan — الفرقان">
          <span class="brand-english" lang="en" dir="ltr">The Furqan</span>
          <span class="brand-arabic" lang="ar" dir="rtl">الفرقان</span>
        </a>
        <div class="tools">
          <button class="plain" data-open="search" aria-label={c.search}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={icon.search} />
            </svg>
            <span class="search-label">{c.search}</span>
          </button>
          <button class="plain" data-open="languages" aria-label={c.languages}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={icon.globe} />
            </svg>
            {languages[lang]} <span aria-hidden="true">⌄</span>
          </button>
          <div class="size-controls">
            <button
              id="smaller"
              class="circle"
              aria-label={c.smaller}
              title={c.smaller}
            >
              −
            </button>
            <button
              id="larger"
              class="circle"
              aria-label={c.larger}
              title={c.larger}
            >
              +
            </button>
          </div>
          <button id="theme" class="circle" aria-label={c.dark} title={c.dark}>
            <span aria-hidden="true">☾</span>
          </button>
        </div>
      </div>
    </header>
    <main id="main" class="wrap">
      {Astro.slots.has("default") ? (
        <slot />
      ) : (
        <>
          <section class="hero">
            <div>
              <p class="eyebrow">{c.eyebrow}</p>
              <h1>
                {c.title}
                <br />
                <span>{c.title2}</span>
              </h1>
              <p class="intro">{c.intro}</p>
              <div class="actions">
                <button class="primary" data-section="0">
                  {c.start}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d={icon.arrow} />
                  </svg>
                </button>
                <a class="secondary" href="#approach">
                  {c.method}
                </a>
              </div>
            </div>
            <div class="entry">
              <p class="entry-label">{c.exploreNote}</p>
              <button class="entry-search" data-open="search">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d={icon.search} />
                </svg>
                {c.searchHint}
              </button>
              <div class="entry-links">
                {[1, 2, 3].map((i) => (
                  <button class="chip" data-section={i}>
                    {c.sections[i]}
                  </button>
                ))}
              </div>
            </div>
          </section>
          <section aria-labelledby="explore">
            <div class="section-top">
              <h2 id="explore">{c.explore}</h2>
              <p>{c.exploreNote}</p>
            </div>
            <div class="cards">
              {c.sections.map((title, i) => (
                <button class="card" data-section={i}>
                  <div class="card-top">
                    <span>{c.numbers[i]}</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d={icon.arrow} />
                    </svg>
                  </div>
                  <h3>{title}</h3>
                  <p>{c.descriptions[i]}</p>
                </button>
              ))}
            </div>
          </section>
          <section class="trust" id="approach">
            <div>
              <h2>{c.trust}</h2>
              <p>{c.trustText}</p>
              <div class="trust-links">
                <a href={`/${lang}/introduction/`}>{c.about} ↗</a>
                <a href={`/${lang}/methodology/`}>{c.methodology} ↗</a>
              </div>
            </div>
            <ol class="principles">
              {c.principles.map((v, i) => (
                <li>
                  <span aria-hidden="true">{c.numbers[i]}</span>
                  {v}
                </li>
              ))}
            </ol>
          </section>
        </>
      )}
    </main>
    <footer class="wrap">
      <span>© {new Date().getFullYear()} The Furqan · الفرقان</span>
      <span>{c.footer}</span>
      <span>{c.development}</span>
    </footer>
    <dialog id="menu" aria-labelledby="menu-title">
      <div class="dialog-head">
        <h2 id="menu-title">{c.menu}</h2>
        <button class="circle" data-close aria-label={c.close}>
          ×
        </button>
      </div>
      <div class="menu-grid">
        <div>
          <h3>{c.explore}</h3>
          {c.sections.map((s, i) => (
            <button data-section={i}>{s}</button>
          ))}
        </div>
        <div>
          <h3>{c.your}</h3>
          <button data-info="bookmarks">{c.bookmarks}</button>
          <button data-info="resume">{c.resume}</button>
          <h3>{c.method}</h3>
          <a href={`/${lang}/introduction/`}>{c.about}</a>
          <a href={`/${lang}/methodology/`}>{c.methodology}</a>
          <button id="reset">{c.reset}</button>
        </div>
      </div>
    </dialog>
    <dialog id="languages" aria-labelledby="languages-title">
      <div class="dialog-head">
        <h2 id="languages-title">{c.languages}</h2>
        <button class="circle" data-close aria-label={c.close}>
          ×
        </button>
      </div>
      <p class="note">{c.languageNote}</p>
      <div class="language-list">
        {Object.entries(languages).map(([key, value]) => (
          <a
            href={`/${key}/${pageSuffix ? pageSuffix + "/" : ""}`}
            lang={key}
            data-language={key}
            aria-current={key === lang ? "page" : undefined}
          >
            <span>{value}</span>
            <span aria-hidden="true">{key === lang ? "✓" : "↗"}</span>
          </a>
        ))}
      </div>
    </dialog>
    <dialog id="search" aria-labelledby="search-title">
      <div class="dialog-head">
        <h2 id="search-title" tabindex="-1">
          {c.search}
        </h2>
        <button class="circle" data-close aria-label={c.close}>
          ×
        </button>
      </div>
      <form id="jump" class="jump" novalidate>
        <p>{c.direct}</p>
        <div class="fields">
          <label>
            {c.chapter}
            <select id="chapter">
              {surahs.map((s) => (
                <option value={s.number}>
                  {new Intl.NumberFormat(lang, {useGrouping:false, numberingSystem: lang === "ar" ? "arab" : lang === "fa" ? "arabext" : "latn"}).format(s.number)}.{" "}
                  {lang === "en"
                    ? `${s.enName} — ${s.enMeaning}`
                    : lang === "fa"
                      ? `${s.faName} — ${s.faMeaning}`
                      : s.arName}
                </option>
              ))}
            </select>
          </label>
          <label>
            <span>{c.verse} · <bdi id="verse-range">1–7</bdi></span>
            <input
              id="verse"
              type="text"
              data-max="7"
              dir="ltr"
              value="1"
              required
              inputmode="numeric"
            />
          </label>
          <button class="primary" type="submit">
            {c.go}
          </button>
        </div>
        <p id="verse-notice" class="note" role="status"></p>
      </form>
      <div class="filters" aria-label={c.search}>
        {c.filters.map((s, i) => (
          <button
            class="chip"
            data-filter={i}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            {s}
          </button>
        ))}
      </div>
      <input
        id="query"
        class="search-input"
        type="search"
        placeholder={c.searchHint}
        aria-label={c.search}
        autocomplete="off"
      />
      <p class="note">{c.searchNote}</p>
      <div id="results" aria-live="polite"></div>
    </dialog>
    <dialog id="info" aria-labelledby="info-title">
      <div class="dialog-head">
        <h2 id="info-title"></h2>
        <button class="circle" data-close aria-label={c.close}>
          ×
        </button>
      </div>
      <p id="info-body"></p>
    </dialog>
    <dialog id="verse-preview" aria-labelledby="verse-preview-title">
      <div class="dialog-head">
        <h2 id="verse-preview-title"></h2>
        <button class="circle" data-close aria-label={c.close}>
          ×
        </button>
      </div>
      <p>{c.unavailable}</p>
      <div class="actions">
        <a id="verse-full" class="primary">
          {lang === "fa"
            ? "باز کردن صفحه آیه"
            : lang === "ar"
              ? "فتح صفحة الآية"
              : "Open full verse"}
        </a>
        <a id="verse-chapter" class="secondary">
          {lang === "fa"
            ? "مطالعه در سوره"
            : lang === "ar"
              ? "القراءة في السورة"
              : "Read in chapter"}
        </a>
      </div>
    </dialog>
    <script define:vars={{ c, surahs, lang }}>
      const $ = (id) => document.getElementById(id);
      let trigger = null;
      const sizes = [80, 90, 100, 110, 120, 130];
      function open(id, reading = false) {
        const active = document.querySelector("dialog[open]");
        if (!active) trigger = document.activeElement;
        active?.close();
        $(id).showModal();
        if (id === "search") {
          // Avoid opening the phone keyboard or native select before the user chooses.
          const mobile = matchMedia("(max-width: 600px)").matches;
          $(mobile ? "search-title" : reading ? "chapter" : "query").focus({
            preventScroll: true,
          });
          $("search").scrollTop = 0;
        }
      }
      function info(title, body) {
        $("info-title").textContent = title;
        $("info-body").textContent = body;
        open("info");
      }
      function section(i) {
        if (i === 0) {
          open("search", true);
        } else info(c.sections[i], c.unavailable);
      }
      document.addEventListener("click", (e) => {
        const reference = e.target.closest("a[data-verse]");
        if (
          reference &&
          !e.ctrlKey &&
          !e.metaKey &&
          !e.shiftKey &&
          !e.altKey &&
          e.button === 0
        ) {
          e.preventDefault();
          const [chapter, verse] = reference.dataset.verse.split(":");
          $("verse-preview-title").textContent =
            c.visit + " " + chapter + ":" + verse;
          $("verse-full").href = reference.href;
          $("verse-chapter").href =
            "/" + lang + "/" + chapter + "/#verse-" + verse;
          open("verse-preview");
          return;
        }
        const b = e.target.closest("button");
        if (!b) return;
        if (b.dataset.open) open(b.dataset.open);
        if (b.hasAttribute("data-close")) {
          b.closest("dialog").close();
          trigger?.focus();
        }
        if (b.dataset.section !== undefined) section(Number(b.dataset.section));
        if (b.dataset.info) {
          const k = b.dataset.info;
          info(
            k === "about"
              ? c.about
              : k === "method"
                ? c.methodology
                : k === "resume"
                  ? c.resume
                  : c.bookmarks,
            k === "about"
              ? c.aboutText
              : k === "method"
                ? c.methodText
                : c.empty,
          );
        }
      });
      document.querySelectorAll("dialog").forEach((d) =>
        d.addEventListener("click", (e) => {
          if (e.target === d) {
            const r = d.getBoundingClientRect();
            if (
              e.clientX < r.left ||
              e.clientX > r.right ||
              e.clientY < r.top ||
              e.clientY > r.bottom
            ) {
              d.close();
              trigger?.focus();
            }
          }
        }),
      );
      function save(k, v) {
        try {
          localStorage.setItem(k, v);
        } catch {}
      }
      function theme() {
        const dark = document.documentElement.dataset.theme === "dark";
        $("theme").firstElementChild.textContent = dark ? "☀" : "☾";
        $("theme").setAttribute("aria-label", dark ? c.light : c.dark);
        $("theme").title = dark ? c.light : c.dark;
      }
      $("theme").onclick = () => {
        document.documentElement.dataset.theme =
          document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        save("furqan-theme", document.documentElement.dataset.theme);
        theme();
      };
      theme();
      function size(delta) {
        let n = parseInt(document.documentElement.style.fontSize) || 100;
        n = sizes[Math.max(0, Math.min(5, sizes.indexOf(n) + delta))];
        document.documentElement.style.fontSize = n + "%";
        save("furqan-size", n);
        $("smaller").disabled = n === 80;
        $("larger").disabled = n === 130;
      }
      $("smaller").onclick = () => size(-1);
      $("larger").onclick = () => size(1);
      $("reset").onclick = () => {
        document.documentElement.style.fontSize = "100%";
        size(0);
      };
      size(0);
      document
        .querySelectorAll("[data-language]")
        .forEach((a) =>
          a.addEventListener("click", () =>
            save("furqan-language", a.dataset.language),
          ),
        );
      const formatNumber = (n) =>
        new Intl.NumberFormat(lang, {useGrouping:false, numberingSystem: lang === "ar" ? "arab" : lang === "fa" ? "arabext" : "latn"}).format(n);
      function chapterChanged() {
        const max = surahs[Number($("chapter").value) - 1].ayahs;
        $("verse").dataset.max = String(max);
        $("verse").value = "1";
        $("verse-range").textContent =
          formatNumber(1) + "–" + formatNumber(max);
        $("verse-notice").textContent = "";
      }
      $("chapter").onchange = chapterChanged;
      chapterChanged();
      function clampVerse() {
        const input = $("verse");
        const normalized = normalize(input.value.trim());
        const raw = normalized === "" ? NaN : Number(normalized);
        const max = Number(input.dataset.max);
        const verse = Number.isFinite(raw)
          ? Math.max(1, Math.min(max, Math.trunc(raw)))
          : 1;
        input.value = String(verse);
        if (raw !== verse)
          $("verse-notice").textContent = c.verseAdjusted
            .replace("{max}", formatNumber(max))
            .replace("{verse}", formatNumber(verse));
        return verse;
      }
      $("verse").addEventListener("blur", clampVerse);
      $("verse").addEventListener("input", () => {
        $("verse-notice").textContent = "";
      });
      function passage(ch, v, notice = "") {
        info(
          c.visit + " " + ch + ":" + v,
          [notice, c.unavailable].filter(Boolean).join(" "),
        );
      }
      $("jump").onsubmit = (e) => {
        e.preventDefault();
        const verse = clampVerse();
        passage(
          Number($("chapter").value),
          verse,
          $("verse-notice").textContent,
        );
      };
      let filter = 0;
      function normalize(s) {
        return s
          .toLowerCase()
          .replace(/[۰-۹]/g, (d) => "۰۱۲۳۴۵۶۷۸۹".indexOf(d))
          .replace(/[٠-٩]/g, (d) => "٠١٢٣٤٥٦٧٨٩".indexOf(d));
      }
      function results() {
        const q = normalize($("query").value.trim());
        $("results").replaceChildren();
        if (!q) return;
        const ref = q.match(/^(\d{1,3})\s*[:：]\s*(\d{1,3})$/);
        if (ref) {
          const ch = Number(ref[1]),
            v = Number(ref[2]);
          if (ch >= 1 && ch <= 114 && v >= 1 && v <= surahs[ch - 1].ayahs) {
            const b = document.createElement("button");
            b.className = "result";
            b.textContent = c.visit + " " + ch + ":" + v;
            b.onclick = () => passage(ch, v);
            $("results").append(b);
            return;
          }
        }
        c.sections.forEach((s, i) => {
          if (filter !== 0 && ![1, 2, 3, 5].includes(filter)) return;
          if (filter && [1, 2, 3, 5][i] !== filter) return;
          if (q && !normalize(s + " " + c.descriptions[i]).includes(q)) return;
          const b = document.createElement("button");
          b.className = "result";
          b.textContent = s;
          b.onclick = () => section(i);
          $("results").append(b);
        });
        if (!$("results").children.length) {
          const p = document.createElement("p");
          p.className = "note";
          p.textContent = c.resultEmpty;
          $("results").append(p);
        }
      }
      $("query").oninput = results;
      document.querySelectorAll("[data-filter]").forEach(
        (b) =>
          (b.onclick = () => {
            filter = Number(b.dataset.filter);
            $("query").placeholder = c.searchHints[filter];
            document
              .querySelectorAll("[data-filter]")
              .forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
            results();
          }),
      );
      results();
    </script>
  </body>
</html>
